# ---------------------------------------------------------------------------
# Copy to .env and adjust. `.env` is git-ignored (*.env in .gitignore).
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- MS SQL Server ---------------------------------------------------------
# Must satisfy SQL Server complexity rules (8+ chars, 3 of: upper, lower,
# digit, symbol). Avoid ; " ' and $ — they break connection strings.
MSSQL_SA_PASSWORD=Local_Dev_P4ssw0rd
MSSQL_DATABASE=DataProcessor
MSSQL_PORT=1433

# --- RabbitMQ --------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Unstable external API -------------------------------------------------
WEAKAPP_API_KEY=supersecret
WEAKAPP_PORT=8080

# --- Published service ports (host side) -----------------------------------
INGESTOR_PORT=5001
PROCESSOR_PORT=5002
GRAPHQL_PORT=5003
NOTIFICATION_PORT=5004
FRONTEND_PORT=3000

# --- Build -----------------------------------------------------------------
BUILD_CONFIGURATION=Release
LOG_LEVEL=Debug

# GitHub PAT with read:packages — required to build the DataProcessor image,
# which restores from the private nuget.pkg.github.com/sailtor feed.
# Keep this out of git; it is passed to the build as a BuildKit secret.
GITHUB_TOKEN=
